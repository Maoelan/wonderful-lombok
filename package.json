{
  "name": "wonderful-lombok",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "build": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
    "preview": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
    "start": "vite preview",
    "test": "node --test tests/*.test.js",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "showcase:seed": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-showcase.js",
    "admin:create": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/create-admin.js",
    "test:auth": "node --env-file=.env scripts/smoke-auth.js",
    "test:booking": "node --env-file=.env scripts/smoke-booking.js"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@sveltejs/adapter-vercel": "^7.0.0",
    "convex": "^1.46.0",
    "leaflet": "1.9.4",
    "sanitize-html": "^2.18.0"
  }
}
