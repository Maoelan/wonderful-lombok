PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SERVER_SECRET=generate-a-long-random-secret
PUBLIC_RENTAL_ENABLED=false
BODY_SIZE_LIMIT=4.5M
PUBLIC_SITE_URL=http://127.0.0.1:5173
# Server-side place search and route calculation, plus the browser map, use Mapbox.
# Public Mapbox access token for the browser map and, in this local demo, server-side Search Box API, Geocoding API v5 fallback, and Directions API v5.
# Public tokens are browser-visible by design. Restrict them to the intended URLs and scopes; never put a secret sk. token here.
PUBLIC_MAPBOX_TOKEN=
# Optional server-only Mapbox token. If set, it takes precedence over PUBLIC_MAPBOX_TOKEN.
MAPBOX_SERVER_TOKEN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
