PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SERVER_SECRET=generate-a-long-random-secret
PUBLIC_RENTAL_ENABLED=false
BODY_SIZE_LIMIT=4.5M
PUBLIC_SITE_URL=http://127.0.0.1:5173
# Browser key restricted to Maps JavaScript API and approved HTTP referrers.
PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only key restricted to Places API (New) and Routes API. Never expose it to the browser.
GOOGLE_MAPS_SERVER_API_KEY=
# Active map provider for the route planner: google (default) or mapbox.
MAP_PROVIDER=google
# Public Mapbox token for Mapbox GL JS. Browser-visible by design; restrict it to approved URLs.
PUBLIC_MAPBOX_TOKEN=
# Server-only Mapbox token restricted to Geocoding API v5 and Directions API v5. Never expose it to the browser.
MAPBOX_SERVER_TOKEN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
